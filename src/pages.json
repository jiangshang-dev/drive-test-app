{
  // 组件自动导入
  "easycom": {
    "autoscan": true,
    "custom": {
      // uni-ui 规则如下配置
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "驾考通"
      }
    },
    {
      "path": "pages/my/my",
      "style": {
        "navigationBarTitleText": "我的",
        // "navigationStyle": "custom",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/cart/cart",
      "style": {
        "navigationBarTitleText": "购物车"
      }
    },
    {
      "path": "pages/category/category",
      "style": {
        "navigationBarTitleText": "分类"
      }
    },
    {
      "path": "pages/index/sequential/sequential",
      "style": {
        "navigationBarTitleText": "顺序刷题"
      }
    },
    {
      "path": "pages/index/exam/exam",
      "style": {
        "navigationBarTitleText": "模拟考试"
      }
    },
    {
      "path": "pages/index/exam/submit",
      "style": {
        "navigationBarTitleText": "查看成绩"
      }
    },
    {
      "path": "pages/login/login",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pagesMember/settings/settings",
      "style": {
        "navigationBarTitleText": "设置"
      }
    },
    {
      "path": "pages/wrong-questions/wrong-questions",
      "style": {
        "navigationBarTitleText": "错题本"
      }
    },
    {
      "path": "pages/favorites/favorites",
      "style": {
        "navigationBarTitleText": "我的收藏"
      }
    },
    {
      "path": "pages/study-record/study-record",
      "style": {
        "navigationBarTitleText": "学习记录"
      }
    },
    {
      "path": "pages/exam-record/exam-record",
      "style": {
        "navigationBarTitleText": "考试记录"
      }
    },
    {
      "path": "pages/statistics/statistics",
      "style": {
        "navigationBarTitleText": "学习统计"
      }
    },
    {
      "path": "pages/points-mall/points-mall",
      "style": {
        "navigationBarTitleText": "积分商城"
      }
    },
    {
      "path": "pages/videos/videos",
      "style": {
        "navigationBarTitleText": "交规视频"
      }
    },
    {
      "path": "pages/traffic-signs/traffic-signs",
      "style": {
        "navigationBarTitleText": "交通标志图示详解"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "",
    "navigationBarBackgroundColor": "#667eea",
    "backgroundColor": "#F8F8F8"
  },
  // 设置 TabBar
  "tabBar": {
    "color": "#333",
    "selectedColor": "#667eea",
    "backgroundColor": "#fff",
    "borderStyle": "white",
    "list": [
      {
        "text": "首页",
        "pagePath": "pages/index/index",
        "iconPath": "static/tabs/home_default.png",
        "selectedIconPath": "static/tabs/home_selected.png"
      },
      {
        "text": "我的",
        "pagePath": "pages/my/my",
        "iconPath": "static/tabs/user_default.png",
        "selectedIconPath": "static/tabs/user_selected.png"
      }
    ]
  }
}
